# =============================================================================
# AnnData — Environment Configuration
# =============================================================================
# The application works with ZERO configuration using the defaults below.
# Nothing here is required to run the local demo. Copy this file to `.env`
# inside backend/ (and frontend/ where noted) only if you want to override
# a default.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — general
# -----------------------------------------------------------------------------
# Environment name, affects logging verbosity only. One of: development, test, production
ANNADATA_ENV=development

# SQLite is the zero-cost default. To use Postgres later, set e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/annadata
DATABASE_URL=sqlite:///./annadata.db

# -----------------------------------------------------------------------------
# Authentication (JWT) — REQUIRED to change before any real deployment.
# A development default is provided so the app runs with zero setup.
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=annadata-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS — comma separated list of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# File storage — local filesystem is the zero-cost default.
# Set STORAGE_BACKEND=s3 in the future to use S3-compatible object storage
# (not required, not implemented as mandatory — abstraction only).
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5

# -----------------------------------------------------------------------------
# AI preliminary screening — OPTIONAL. The platform ships a deterministic,
# offline, local mock screening service and works fully without any key.
# If AI_SCREENING_PROVIDER=local (default), no key is read or required.
# Setting it to "external" is NOT implemented in the MVP on purpose, to avoid
# any accidental dependency on a paid API for the core workflow.
# -----------------------------------------------------------------------------
AI_SCREENING_PROVIDER=local

# -----------------------------------------------------------------------------
# Maps — OPTIONAL. Free/OpenStreetMap tiles are used by default and require
# no API key. Leave unset for the demo.
# -----------------------------------------------------------------------------
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# -----------------------------------------------------------------------------
# Payments — mock only. No real payment gateway is used or required.
# -----------------------------------------------------------------------------
PAYMENTS_PROVIDER=mock

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# Frontend (frontend/.env) — Vite only exposes variables prefixed VITE_
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
